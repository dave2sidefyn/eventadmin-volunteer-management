#: includes/admin/documentation.php:23 includes/admin/documentation.php:24
msgid "Documentation"
msgstr "Dokumentation"

#: includes/admin/documentation.php:36
msgid "📘 EventAdmin Plugin – Documentation"
msgstr "📘 EventAdmin-Plugin – Dokumentation"

#: includes/admin/documentation.php:39
