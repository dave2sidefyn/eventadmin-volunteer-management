#. Plugin Name of the plugin
#: eventadmin-volunteer-management.php
msgid "EventAdmin – Volunteer Management"
msgstr "EventAdmin – Volunteer Management"

#. Description of the plugin
#: eventadmin-volunteer-management.php
msgid ""
"Manage volunteers for events directly in WordPress. Create and schedule "
"shifts, allow volunteers to sign up and cancel independently, and configure "
"individual rules – e.g., maximum shifts per person per year."
msgstr ""
"Administrer frivillige for arrangementer direkte i WordPress. Opprett og "
"planlegg vakter, la frivillige melde seg på og av selv, og sett egne regler "
"– f.eks. maks antall vakter per person per år."

#. Author of the plugin
#: eventadmin-volunteer-management.php
msgid "David Wiedmer, sidefyn GmbH"
msgstr "David Wiedmer, sidefyn GmbH"

