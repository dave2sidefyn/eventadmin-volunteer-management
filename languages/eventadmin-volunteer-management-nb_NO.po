msgid "EventAdmin Settings"
msgstr "EventAdmin-innstillinger"

#: includes/admin/settings.php:214
msgid "Available placeholders:"
msgstr "Tilgjengelige plassholdere:"

#: includes/admin/settings.php:216
msgid "First name of the volunteer"
msgstr "Fornavn til den frivillige"

#: includes/admin/settings.php:217
msgid "Last name of the volunteer"
msgstr "Etternavn til den frivillige"

