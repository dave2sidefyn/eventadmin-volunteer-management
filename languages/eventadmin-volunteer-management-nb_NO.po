msgid "Skipped – e-mail already in use:"
msgstr "Hoppet over – e-postadresse allerede i bruk:"

#: includes/admin/import.php:186 includes/admin/import.php:218
msgid "Skipped – invalid rows:"
msgstr "Hoppet over – ugyldige rader:"

#. translators: %d: number of shifts created
#: includes/admin/import.php:208
#, php-format
msgid "%d shift(s) imported."
msgstr "%d vakt(er) importert."

#: includes/admin/import.php:217
